          "namespace": "AWS/AmplifyHosting",
          "metricName": "Requests",
          "dimensions": { "App": "$app" },
          "statistic": "Sum",
          "period": "",
          "region": "default",
          "label": "Requests"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "timeseries",
      "datasource": "CloudWatch",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "requests",
          "datasource": "CloudWatch",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/AmplifyHosting",
          "metricName": "Requests",
          "dimensions": { "App": "$app" },
          "statistic": "Sum",
          "period": "",
          "region": "default",
          "id": "requests",
          "hide": true
        },
        {
          "refId": "errors4xx",
          "datasource": "CloudWatch",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/AmplifyHosting",
          "metricName": "4xxErrors",
          "dimensions": { "App": "$app" },
          "statistic": "Sum",
          "period": "",
          "region": "default",
          "id": "errors4xx",
          "hide": true
        },
        {
          "refId": "errors5xx",
          "datasource": "CloudWatch",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/AmplifyHosting",
          "metricName": "5xxErrors",
          "dimensions": { "App": "$app" },
          "statistic": "Sum",
          "period": "",
          "region": "default",
          "id": "errors5xx",
          "hide": true
        },
        {
          "refId": "errorRate",
          "datasource": "CloudWatch",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "100 * (errors4xx + errors5xx) / requests",
          "label": "Error rate",
          "period": "",
          "region": "default",
          "id": "errorRate"
        }
      ]
    },
